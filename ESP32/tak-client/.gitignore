.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ---------------------------------------------------------------------------
# Secrets. None of this may ever be committed.
# ---------------------------------------------------------------------------
# Credentials and the embedded client certificate.
include/secrets.h
include/certs.h
include/*.bak
*.bak

# Everything downloaded from the server: certificates, private keys, data
# packages. TAK data packages embed a client private key AND the .p12 password
# in plaintext inside config.pref, so the zips are as sensitive as a raw key.
server/

# Belt and braces, wherever they land.
*.p12
*.jks
*.key
*.pem
*_password.txt
*.enrolluser

# Keep the templates - they contain only placeholders.
!include/secrets.example.h
!include/certs.example.h
