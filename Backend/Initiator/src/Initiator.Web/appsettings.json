{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "DatabaseName": "initiator",
    "LogRetentionDays": 30,
    "StateEventRetentionDays": 365
  },
  "Initiator": {
    "ExpectedReportPeriodSeconds": 30
  }
}
