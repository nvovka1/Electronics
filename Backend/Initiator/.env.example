# Copy to .env and fill in. .env is gitignored and must stay that way - the
# connection string carries a database password.
#
#   cp .env.example .env
#   docker compose up --build

# Full mongodb:// or mongodb+srv:// URI, with credentials.
# For the bundled local database:  mongodb://mongo:27017
MONGO_CONNECTION_STRING=

# Its own database, separate from LoraFleet's.
MONGO_DATABASE=initiator

# The shared key every node presents in the X-Api-Key header.
# Generate one with:  openssl rand -hex 32
DEVICE_API_KEY=

# How often a node is expected to check in. Only used to decide when silence is
# worth noticing; it is not pushed to the devices.
EXPECTED_REPORT_PERIOD_SECONDS=30

# Logs are the bulk of the data. State events are the record of what the nodes
# actually did, so they are kept far longer.
LOG_RETENTION_DAYS=30
STATE_EVENT_RETENTION_DAYS=365

# 8081 by default so this can run alongside LoraFleet on 8080.
WEB_PORT=8081
MONGO_PORT=27018
