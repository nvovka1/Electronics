# Copy to .env and fill in. .env is gitignored and must stay that way:
# the connection string below carries a database password.
#
#   cp .env.example .env

# --- database -------------------------------------------------------------
# The full Atlas URI, including credentials.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# Or, with the local-db compose profile:
#   mongodb://mongo:27017
MONGO_CONNECTION_STRING=

MONGO_DATABASE=lorafleet

# Log records are the bulk of the data and the least valuable part of it once a
# problem is closed, so they expire rather than growing without limit.
LOG_RETENTION_DAYS=30

# --- device API -----------------------------------------------------------
# Shared secret every node sends in the X-Api-Key header. Without it the ingest
# endpoints are open to anyone who finds the URL, so the app refuses to start
# outside Development when this is empty.
#
# Generate one with:  openssl rand -hex 32
DEVICE_API_KEY=

# How often a node is expected to check in. Only used to decide when silence is
# worth noticing; it is not pushed to the devices.
EXPECTED_REPORT_PERIOD_SECONDS=60

# The URL devices actually reach this service on. Needed behind a proxy or on a
# PaaS, where the request's own host is the container's and is not routable from
# outside. Without it the update manifest hands out download links nothing can
# resolve. Leave empty only when the container is reached directly.
PUBLIC_BASE_URL=https://electronics-fq9f.onrender.com

# --- hosting --------------------------------------------------------------
WEB_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
